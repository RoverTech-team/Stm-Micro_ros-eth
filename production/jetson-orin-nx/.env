DASHBOARD_PORT=5050

ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
RMW_FASTRTPS_USE_SHM=0
MICROROS_DISABLE_SHM=1
CYCLONEDDS_URI=
FASTRTPS_DEFAULT_PROFILES_FILE=
ROS_DISCOVERY_SERVER=
ROS_AUTOMATIC_DISCOVERY_RANGE=
ROS_STATIC_PEERS=

MICROK3_METRICS_INTERVAL_SEC=2.0
MICROK3_METRICS_DOCKER_SERVICES=micro-ros-agent,microk3,renode-bridge

RENODE_NODE_ID=755
RENODE_NODE_NAME=renode-stm32h755
RENODE_NODE_TYPE=Renode STM32H755
RENODE_NODE_NETWORK=Docker Renode TAP
RENODE_HEARTBEAT_TOPIC=heartbeat
RENODE_HEARTBEAT_TIMEOUT_SEC=50.0

MICROK3_STATUS_TOPIC=microk3/node_status
MICROK3_ALERT_TOPIC=microk3/system_alerts
MICROK3_COMMAND_TOPIC=microk3/commands
HEARTBEAT_LOG_INTERVAL_SEC=30

AGENT_PORT=8888
AGENT_BIND_ADDR=0.0.0.0
MICROROS_AGENT_IP=192.168.0.1
STM_BOARD_IP=192.168.0.2

TAP_INTERFACE=tap0
TAP_GATEWAY_CIDR=192.168.50.1/24

SECRET_KEY=e2e-test-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
LOG_LEVEL=INFO

# Supported values: renode, hil, hil-host, hil-macos
STACK=hil-host


# Arm bridge topic remapping (all optional — defaults match firmware and Roscontrol conventions)
ARM_STATES_INPUT_TOPIC=/joint_states
ARM_COMMANDS_OUTPUT_TOPIC=/joint_commands
ARM_STATES_OUTPUT_TOPIC=/hardware_level/states
ARM_COMMANDS_INPUT_TOPIC=/hardware_level/commands
