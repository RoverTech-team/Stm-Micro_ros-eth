DASHBOARD_PORT=5050
ROS_DOMAIN_ID=0

RENODE_NODE_ID=755
RENODE_NODE_NAME=renode-stm32h755
RENODE_NODE_TYPE=Renode STM32H755
RENODE_NODE_NETWORK=Docker Renode TAP

RENODE_HEARTBEAT_TOPIC=heartbeat
RENODE_HEARTBEAT_TIMEOUT_SEC=5.0

MICROK3_STATUS_TOPIC=microk3/node_status
MICROK3_ALERT_TOPIC=microk3/system_alerts
MICROK3_COMMAND_TOPIC=microk3/commands
HEARTBEAT_LOG_INTERVAL_SEC=30

AGENT_PORT=8888
AGENT_BIND_ADDR=0.0.0.0
MICROROS_AGENT_IP=192.168.2.17
TAP_INTERFACE=tap0
TAP_GATEWAY_CIDR=192.168.50.1/24
STM32_PROGRAMMER_PORT=SWD
# Optional override. If omitted, the scripts first try PATH and then scan /Volumes/Untitled.
# STM32_PROGRAMMER_CLI=/Volumes/Untitled/.../STM32_Programmer_CLI
MAC_HOST_IP=192.168.2.1
STM_BOARD_IP=192.168.2.2
SERIAL_MONITOR=1
SERIAL_PORT=/dev/cu.usbmodem1203
SERIAL_BAUD=115200
CM4_IMAGE=/absolute/path/to/Makefile/CM4/build/MicroRosEth_CM4.elf
CM4_MAKE_DIR=/absolute/path/to/Makefile/CM4
CM7_MAKE_DIR=/absolute/path/to/Makefile/CM7_hil
CM7_IMAGE=/absolute/path/to/Makefile/CM7_hil/build/MicroRosEth_CM7_HIL.elf

SECRET_KEY=e2e-test-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=testpass123
LOG_LEVEL=INFO

# Supported values: renode, hil, hil-macos
STACK=renode
