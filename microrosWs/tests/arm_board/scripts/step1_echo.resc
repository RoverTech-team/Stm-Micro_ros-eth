# ARM main-board BRINGUP step 1: net + echo (no motion).
# cm7_echo (0x08000000) + cm4_follow (0x08100000). Paths repo-root-
# relative: always run via scripts/run_sim.sh (it cds to repo root).
# Custom models (drivers/encoders/IMUs) compile via Roslyn include.
# Paths are repo-root-relative (run via scripts/run_sim.sh).

$name?="arm-board-step1"
$cm7?=@microrosWs/Micro_ros_eth/microroseth/BRINGUP/cm7_echo/build/MicroRosEth_CM7_echo.elf
$cm4?=@microrosWs/Micro_ros_eth/microroseth/BRINGUP/cm4_follow/build/MicroRosEth_CM4_follow.elf

include @microrosWs/tests/arm_board/peripherals/PowerStep01Chain.cs
include @microrosWs/tests/arm_board/peripherals/QuadratureEncoder.cs
include @microrosWs/tests/arm_board/peripherals/SpiImu.cs

mach create $name
machine LoadPlatformDescription @microrosWs/tests/arm_board/platforms/arm_main_pcb.repl

logLevel 1
logLevel 3 usart3
logLevel 3 ethernet

showAnalyzer usart3

emulation CreateSwitch "switch"
connector Connect ethernet switch

sysbus LoadELF $cm7 cpu=cm7
sysbus LoadELF $cm4 cpu=cm4

sysbus AddWatchpointHook 0x40004828 1 Write "self.InfoLog('UART3:' + chr(value & 0xFF))"
sysbus AddWatchpointHook 0x58026400 4 Write "monitor.Parse('log \"CM7 HSEM release observed; unhalting CM4\"'); monitor.Parse('cm4 IsHalted false')"

start

python "print('RESULT drivers=6')"
python "print('RESULT encoders=5')"
python "print('RESULT imus=2')"
sleep 12

# Functional asserts (UART is silent in sim: TXE never reads ready, so
# HAL_UART_Transmit times out; boot text never reaches USART3. Assert on
# sim state instead - same firmware behavior, observable path).
python "bus = [e for e in list(emulationManager.CurrentEmulation.GetEmulationElements()) if type(e).__name__=='Machine'][0].SystemBus"
python "v = bus.ReadDoubleWord(0x38000000); print('RESULT shared_magic=%08X %s' % (v, 'OK' if v == 0x53485244 else 'FAIL'))"
python "v = bus.ReadDoubleWord(0x38000004); print('RESULT shared_version=%08X %s' % (v, 'OK' if v == 2 else 'FAIL'))"
python "v = bus.ReadDoubleWord(0x38000060); print('RESULT motor_ready=%08X %s' % (v, 'OK' if v == 1 else 'FAIL'))"
python "bus.WriteDoubleWord(0x5A000000, 1234)"
python "v = bus.ReadDoubleWord(0x5A000000); print('RESULT enc1_loopback=%08X %s' % (v, 'OK' if v == 1234 else 'FAIL'))"
quit
